# =============================================================================
#  CONFIGURAZIONE SDCC-RAG  —  template
#  Copia questo file in `.env` e compila i valori. Il .env NON va committato.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. IMPOSTAZIONI GENERALI / CHUNKING
# -----------------------------------------------------------------------------
# Sorgente dei documenti: "local" (filesystem) oppure "azure" (Blob Storage).
DOCUMENT_SOURCE=local
DATA_PATH=./data
BATCH_SIZE=64
JSON_TEXT_FIELD=text
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# Caratteri max passati all'LLM per summary/keywords durante l'arricchimento.
SEMANTIC_MAX_CHARS=4000

# -----------------------------------------------------------------------------
# 2. VECTOR STORE / EMBEDDING LOCALE
# -----------------------------------------------------------------------------
# Provider di embedding: "openai" | "azure" | "ollama" (locale, gratuito).
# Per ollama serve un server in esecuzione: ollama pull nomic-embed-text
EMBEDDING_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Vector store: "chroma" (locale, su disco) | "azure_search" (cloud).
VECTOR_STORE=chroma
# ChromaDB: persistenza vettoriale su disco.
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=sdcc

# -----------------------------------------------------------------------------
# 3. LLM / AZURE CLOUD  (setup definitivo)
# -----------------------------------------------------------------------------
# --- LLM per arricchimento semantico (summary/keywords) via Azure OpenAI -----
LLM_PROVIDER=azure
AZURE_LLM_DEPLOYMENT="nome-del-deployment"
AZURE_OPENAI_ENDPOINT="https://<resource>.openai.azure.com/"
AZURE_OPENAI_API_KEY="inserire_qui_chiave"
AZURE_OPENAI_API_VERSION="2024-02-15-preview"

# --- Azure Blob Storage (usato quando DOCUMENT_SOURCE=azure) ------------------
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER_NAME="rag-documents"

# --- Azure AI Search (nuovo vector store cloud) ------------------------------
# Usato da infrastructure/setup_azure_search_index.py per creare l'indice.
AZURE_SEARCH_ENDPOINT="https://<service>.search.windows.net"
AZURE_SEARCH_ADMIN_KEY="inserire_qui_admin_key"
AZURE_SEARCH_INDEX_NAME="rag-documents"
# Soglia coseno minima: i match sotto vengono scartati (0.0 = nessun filtro).
AZURE_SEARCH_MIN_SCORE=0.70

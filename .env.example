# Copia in `.env` e compila. Il file .env non va committato (vedi .gitignore).

# --- Selezione del provider di embedding -------------------------------------
# "openai" (default), "azure" oppure "ollama". Cambiare questo valore è l'UNICA
# modifica necessaria per passare da un provider all'altro.
EMBEDDING_PROVIDER=openai

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Azure OpenAI Service (usati solo se EMBEDDING_PROVIDER=azure) ------------
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-01

# --- Ollama (locale e gratuito; usati solo se EMBEDDING_PROVIDER=ollama) ------
# Richiede un server Ollama in esecuzione e il modello scaricato:
#   ollama pull nomic-embed-text
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- LLM per arricchimento semantico (summary/keywords) ----------------------
# Richiede il modello scaricato: ollama pull llama3
LLM_PROVIDER=ollama
OLLAMA_LLM_MODEL=llama3
SEMANTIC_MAX_CHARS=4000

# --- Chunking ----------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- ChromaDB ----------------------------------------------------------------
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=sdcc

# --- Loader JSON / Ingestion -------------------------------------------------
JSON_TEXT_FIELD=text
DATA_PATH=./data
BATCH_SIZE=64
